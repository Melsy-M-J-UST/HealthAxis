@model HealthAxis_MVC.Models.HealthRecord

@{
    ViewBag.Title = "Edit Health Record";
}

<h2 class="text-primary">Edit Health Record</h2>

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(m => m.HealthRecordId)

    <div class="mb-3">
        @Html.LabelFor(m => m.PatientId)
        @Html.DropDownListFor(
            m => m.PatientId,
            ViewBag.Patients as SelectList,
            "-- Select Patient --",
            new { @class = "form-control" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.DoctorId)
        @Html.DropDownListFor(
            m => m.DoctorId,
            ViewBag.Doctors as SelectList,
            "-- Select Doctor --",
            new { @class = "form-control" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.VisitDate)
        @Html.TextBoxFor(
            m => m.VisitDate,
            "{0:yyyy-MM-dd}",
            new { @class = "form-control", type = "date" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Diagnosis)
        @Html.TextBoxFor(
            m => m.Diagnosis,
            new { @class = "form-control" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Prescription)
        @Html.TextBoxFor(
            m => m.Prescription,
            new { @class = "form-control" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Notes)
        @Html.TextBoxFor(
            m => m.Notes,
            new { @class = "form-control" }
        )
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Update</button>
        @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-secondary ms-2" })
    </div>
}