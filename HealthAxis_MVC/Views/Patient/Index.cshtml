@model List<HealthAxis_MVC.Models.Patient>

@{
    ViewBag.Title = "Index";
}

<h2 class="text-primary">Patient Details</h2>

@Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-primary" })

<table class="table table-striped">
    <thead>
        <tr>
            <th>Patient Id</th>
            <th>Full Name</th>
            <th>Date of Birth</th>
            <th>Gender</th>
            <th>Phone Number</th>
            <th>Email</th>
            <th>Insurance ID</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var pat in Model)
        {
            <tr>
                <td>@pat.PatientId</td>
                <td>@pat.FullName</td>
                <td>
                    @{
                        if (pat.DateOfBirth.HasValue)
                        {
                            var today = DateTime.Today;
                            var age = today.Year - pat.DateOfBirth.Value.Year;

                            if (pat.DateOfBirth.Value.Date > today.AddYears(-age))
                            {
                                age--;
                            }

                            @age
                        }
                        else
                        {
                            @("")
                        }
                    }
                </td>
                <td>@pat.Gender</td>
                <td>@pat.PhoneNumber</td>
                <td>@pat.Email</td>
                <td>@pat.InsuranceID</td>
                <td class="d-flex">
                    @Html.ActionLink("Edit", "Edit", new { id = pat.PatientId }, new { @class = "btn btn-outline-primary me-2 w-50" })
                </td>
                <td>
                    @Html.ActionLink("Appointments", "PatientAppointments", "Appointment",new { id = pat.PatientId }, null)
                </td>
            </tr>
        }
    </tbody>
</table>