
@model List<HealthAxis_MVC.Models.Doctor>
@{
    ViewBag.Title = "Index";
}

<h2 class="text-primary">Doctor Details</h2>
@Html.ActionLink("Add New","Create",null,new {@class="btn btn-primary"})

<table class="table table-striped">
    <thead>
       <tr>
        <th>Doctor Id</th>
        <th>FullName</th>
        <th>Specialisation</th>
        <th>Years of Experience</th>
        <th>Consultation Fee</th>
        <th>Is Active</th>
        <th class="text-center">Actions</th>
       </tr>
    </thead>
    <tbody>
        @foreach(var doc in Model)
         {
             <tr>
                 <td>@doc.DoctorId</td>
                 <td>@doc.FullName</td>
                 <td>@doc.Specialisation</td>
                 <td>@doc.YearsOfExperience</td>
                 <td>@doc.ConsultationFee</td>
                 <td>@doc.IsActive</td>
                 <td class="d-flex">
                     @Html.ActionLink("Edit", "Edit", new { id = doc.DoctorId }, new { @class = "btn btn-outline-primary me-2 w-50" })
                 </td>
                 <td>
                     @Html.ActionLink("Appointments", "DoctorAppointments", "Appointment",new { id = doc.DoctorId }, null)
                 </td>
             </tr>
         }
    </tbody>

</table>

