@model HealthAxis_MVC.Models.Doctor

@{
    ViewBag.Title = "Edit";
}

<h2 class="text-success">Update Doctor</h2>

<div class="col-4">
    @using (Html.BeginForm())
    {
        <div class="mb-2">
            @Html.LabelFor(m => m.DoctorId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.DoctorId, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.FullName, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
        </div>


        <div class="mb-2">
            @Html.LabelFor(m => m.Specialisation)
            @Html.DropDownListFor(
                m => m.Specialisation,
                ViewBag.Specialisations as SelectList,
                "-- Select Specialisation --",
                new { @class = "form-control" }
            )
            @Html.ValidationMessageFor(m => m.Specialisation)
        </div>


        <div class="mb-2">
            @Html.LabelFor(m => m.YearsOfExperience, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.YearsOfExperience, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.YearsOfExperience, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.ConsultationFee, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.ConsultationFee, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.IsActive, new { @class = "fw-bold" })
            @Html.CheckBoxFor(m => m.IsActive)
            @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger" })
        </div>

        <div class="d-flex">
            <button class="btn btn-primary me-2 w-50">Update Doctor</button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary w-50" })
        </div>
    }
</div>
``