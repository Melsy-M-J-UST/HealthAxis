@model HealthCareWebApp.Models.Patient

@{
    ViewBag.Title = "Create";
}

<h2 class="text-success">Add Patient</h2>
<div class=col-4>
    @using (Html.BeginForm())
    {
        <div class="mb-2">
            @Html.LabelFor(m => m.PatientId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.PatientId, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.PatientId, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.PatientName, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.PatientName, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.PatientName, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.DateOfBirth, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.DateOfBirth, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.PhoneNumber, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.Email, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-dark  " })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.InsuranceId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.InsuranceId, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.InsuranceId, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.Gender, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.Gender, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.RegisteredDate, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.RegisteredDate, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.RegisteredDate, "", new { @class = "text-danger" })
        </div>
        <div class="d-flex">
            <button class="btn btn-primary me-2 w-50">Add Patient</button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary w-50" })
        </div>
    }
</div>