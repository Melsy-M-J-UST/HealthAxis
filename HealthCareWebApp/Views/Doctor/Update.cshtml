@model HealthCareWebApp.Models.Doctor

@{
    ViewBag.Title = "Update";
}

<h2 class="text-success">Update Doctor</h2>
<div class=col-4>
    @using (Html.BeginForm())
    {
        <div class="mb-2">
            @Html.LabelFor(m => m.DoctorId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.DoctorId, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.DoctorName, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.DoctorName, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.DoctorName, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.Specialisation, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.Specialisation, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.Experience, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.Experience, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.Experience, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.Fees, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.Fees, new { @class = "form-control border-dark  " })
            @Html.ValidationMessageFor(m => m.Fees, "", new { @class = "text-danger" })
        </div>
        <div class="mb-2">
            @Html.LabelFor(m => m.IsActive, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.IsActive, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger" })
        </div>
        <div class="d-flex">
            <button class="btn btn-primary me-2 w-50">Update Doctor</button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary w-50" })
        </div>
    }
</div>
