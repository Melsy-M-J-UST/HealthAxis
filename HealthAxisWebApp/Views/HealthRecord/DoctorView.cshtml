@model IEnumerable<HealthAxis.Shared.DTOs.HealthRecordDto>
@using System.Linq

@{
    ViewBag.Title = "Doctor View";
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h2>Doctor View - Patient Records</h2>
        <p class="text-muted">Enter a Patient ID to view records as a doctor.</p>
    </div>

    @using (Html.BeginForm("DoctorView", "HealthRecord", FormMethod.Get))
    {
        <div class="row justify-content-center mb-4">
            <div class="col-md-4">
                <input type="number"
                       name="patientId"
                       class="form-control"
                       placeholder="Enter Patient ID"
                       required />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100">
                    Load
                </button>
            </div>
        </div>
    }

    @if (ViewBag.HasSearched == true)
    {
        if (Model != null && Model.Any())
        {
            <table class="table table-bordered table-striped table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Doctor</th>
                        <th>Visit Date</th>
                        <th>Diagnosis</th>
                        <th>Prescription</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>Dr. #@item.DoctorId</td>
                            <td>@item.VisitDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Diagnosis</td>
                            <td>@item.Prescription</td>
                            <td>
                                @Html.ActionLink(
                                    "Details",
                                    "Details",
                                    new { id = item.RecordId },
                                    new { @class = "btn btn-info btn-sm" }
                                )
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info text-center">
                No health records found for this patient.
            </div>
        }
    }

</div>