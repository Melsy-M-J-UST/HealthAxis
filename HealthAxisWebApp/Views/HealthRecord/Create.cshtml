@model HealthAxis.Shared.DTOs.HealthRecordDto

@{
    ViewBag.Title = "Add Health Record";
}

<div class="container mt-4">

    <h2>Add Health Record</h2>

    <hr />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(
            true,
            "",
            new { @class = "text-danger" })

        @Html.HiddenFor(m => m.AppointmentId)
        @Html.HiddenFor(m => m.PatientId)
        @Html.HiddenFor(m => m.DoctorId)
        @Html.HiddenFor(m => m.VisitDate)

        <div class="card shadow-sm">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">
                        Appointment ID
                    </label>

                    <input class="form-control"
                           value="@Model.AppointmentId"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Diagnosis
                    </label>

                    @Html.TextAreaFor(
                        m => m.Diagnosis,
                        new
                        {
                            @class = "form-control",
                            rows = 3
                        })

                    @Html.ValidationMessageFor(
                        m => m.Diagnosis,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Prescription
                    </label>

                    @Html.TextAreaFor(
                        m => m.Prescription,
                        new
                        {
                            @class = "form-control",
                            rows = 3
                        })

                    @Html.ValidationMessageFor(
                        m => m.Prescription,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Notes
                    </label>

                    @Html.TextAreaFor(
                        m => m.Notes,
                        new
                        {
                            @class = "form-control",
                            rows = 4
                        })

                    @Html.ValidationMessageFor(
                        m => m.Notes,
                        "",
                        new { @class = "text-danger" })
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Save Health Record
                </button>

                @Html.ActionLink(
                    "Back",
                    "Dashboard",
                    "Appointment",
                    null,
                    new
                    {
                        @class = "btn btn-secondary ms-2"
                    })

            </div>
        </div>
    }

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}