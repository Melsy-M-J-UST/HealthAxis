@{
    ViewBag.Title = "Health Records";
}

<style>
    .health-card {
        border-radius: 12px;
        transition: all 0.2s ease-in-out;
        height: 220px;
    }

        .health-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
        }

        .health-card .card-body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: center;
        }

    .btn-health {
        background: linear-gradient(135deg, #6ee7b7, #34d399);
        border: none;
        color: white;
        border-radius: 8px;
        padding: 10px 14px;
        text-decoration: none;
        font-weight: 500;
    }

        .btn-health:hover {
            background: linear-gradient(135deg, #34d399, #10b981);
            color: white;
        }
</style>

<div class="container mt-5">
    <h2 class="text-center mb-5">Health Records</h2>

    <div class="row justify-content-center g-4">

        <div class="col-md-5">
            <div class="card shadow-sm health-card">
                <div class="card-body">
                    <div>
                        <h4>All Health Records</h4>
                        <p class="text-muted">Browse all records ordered by latest visit date.</p>
                    </div>

                    @Html.ActionLink(
                        "Open",
                        "List",
                        "HealthRecord",
                        null,
                        new { @class = "btn btn-health w-100" }
                    )
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm health-card">
                <div class="card-body">
                    <div>
                        <h4>Patient Health History</h4>
                        <p class="text-muted">View all health records for a specific patient.</p>
                    </div>

                    @Html.ActionLink(
                        "Open",
                        "PatientHistory",
                        "HealthRecord",
                        null,
                        new { @class = "btn btn-health w-100" }
                    )
                </div>
            </div>
        </div>

    </div>
</div>
