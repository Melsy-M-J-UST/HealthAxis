<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HealthAxis</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body style="background-color: #f8f9fa;">

    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm" style="background-color: #0f4c75;">
        <div class="container">
            @Html.ActionLink("HealthAxis", "Index", "Home", new { area = "" }, new { @class = "navbar-brand fw-bold" })
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#healthAxisNav" aria-controls="healthAxisNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="healthAxisNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Patients">Patients</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Doctor">Doctors</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Appointment">Appointments</a>
                    </li>
                </ul>
                <span class="navbar-text text-light opacity-75">
                    Hospital Management System
                </span>
            </div>
        </div>
    </nav>

    <div class="container body-content">

        @RenderBody()

        <hr class="mt-5" />
        <footer class="text-center text-muted pb-4">
            <p>&copy; @DateTime.Now.Year - HealthAxis Web Application | Abhishek Upadhyay</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>