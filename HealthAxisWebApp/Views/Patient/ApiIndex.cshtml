@using System.Linq
@model IEnumerable<HealthAxis.Shared.DTOs.PatientDto>

@{
    ViewBag.Title = "Patients";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Patients</h2>

        @Html.ActionLink("Add New Patient", "Create", "Patient", null, new { @class = "btn btn-primary" })
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No patients found.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Patient ID</th>
                    <th>Full Name</th>
                    <th>Date of Birth</th>
                    <th>Gender</th>
                    <th>Phone Number</th>
                    <th>Email</th>
                    <th>Insurance ID</th>
                    <th style="width: 220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in Model)
                {
                    <tr>
                        <td>@patient.PatientId</td>
                        <td>@patient.FullName</td>
                        <td>@patient.DateOfBirth.ToString("yyyy-MM-dd")</td>
                        <td>@patient.GenderName</td>
                        <td>@patient.PhoneNumber</td>
                        <td>@patient.Email</td>
                        <td>@patient.InsuranceID</td>
                        <td>
                            @Html.ActionLink("Details", "Details", "Patient", new { id = patient.PatientId }, new { @class = "btn btn-sm btn-info me-1" })
                            @Html.ActionLink("Edit", "Edit", "Patient", new { id = patient.PatientId }, new { @class = "btn btn-sm btn-warning me-1" })
                            @Html.ActionLink("Delete", "Delete", "Patient", new { id = patient.PatientId }, new { @class = "btn btn-sm btn-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>