@model HealthAxis.Shared.DTOs.PatientDto

@{
    ViewBag.Title = "Delete Patient";
}

<div class="container mt-4">
    <h2>Delete Patient</h2>
    <hr />

    <div class="alert alert-warning">
        Are you sure you want to delete this patient?
    </div>

    <div class="card">
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <dl class="row">
                <dt class="col-sm-3">Patient ID</dt>
                <dd class="col-sm-9">@Model.PatientId</dd>

                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Date of Birth</dt>
                <dd class="col-sm-9">@Model.DateOfBirth.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Gender</dt>
                <dd class="col-sm-9">@Model.GenderName</dd>

                <dt class="col-sm-3">Phone Number</dt>
                <dd class="col-sm-9">@Model.PhoneNumber</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Insurance ID</dt>
                <dd class="col-sm-9">@Model.InsuranceID</dd>
            </dl>

            @using (Html.BeginForm("Delete", "Patient", new { id = Model.PatientId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">Delete</button>
                @Html.ActionLink("Cancel", "ApiIndex", "Patient", null, new { @class = "btn btn-secondary ms-2" })
            }

        </div>
    </div>
</div>