@model HealthAxis.Shared.DTOs.PatientDto

<style>
    .patient-modal-header {
        background: linear-gradient(135deg, #315e78, #3c6d87);
        color: #fff;
        padding: 16px 20px;
        border-bottom: none;
    }

        .patient-modal-header .modal-title {
            font-size: 1.35rem;
            font-weight: 700;
            margin: 0;
        }

        .patient-modal-header .btn-close {
            filter: invert(1);
            opacity: 0.9;
        }

    .patient-modal-body {
        padding: 24px;
        background: rgba(255,255,255,0.96);
    }

        .patient-modal-body .form-label {
            font-weight: 600;
            color: #1f2a44;
            margin-bottom: 6px;
        }

        .patient-modal-body .form-control,
        .patient-modal-body .form-select {
            border-radius: 10px;
            border: 1px solid #ccd7de;
            min-height: 44px;
            box-shadow: none;
        }

            .patient-modal-body .form-control:focus,
            .patient-modal-body .form-select:focus {
                border-color: #61c4b2;
                box-shadow: 0 0 0 0.18rem rgba(97, 196, 178, 0.18);
            }

        .patient-modal-body .text-danger {
            font-size: 0.84rem;
        }

    .patient-modal-footer {
        border-top: 1px solid #e7edf1;
        padding: 14px 20px;
        background: #fafcfd;
    }

    .btn-save-patient {
        background: linear-gradient(135deg, #67ddb7, #42cfa1);
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 10px;
        padding: 9px 18px;
    }

        .btn-save-patient:hover {
            color: #fff;
            background: linear-gradient(135deg, #4fd3aa, #2fc08d);
        }

    .btn-cancel-patient {
        border-radius: 10px;
        padding: 9px 18px;
        font-weight: 600;
    }
</style>

@using (Html.BeginForm("Edit", "Patient", new { id = Model.PatientId }, FormMethod.Post, new { data_ajax_modal = "true" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.PatientId)

    <div class="modal-header patient-modal-header">
        <h5 class="modal-title">Edit Patient</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body patient-modal-body">
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="mb-3">
            @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.DateOfBirth, new { @class = "form-label" })
            @Html.TextBoxFor(
                m => m.DateOfBirth,
                "{0:yyyy-MM-dd}",
                new
                {
                    @class = "form-control",
                    type = "date",
                    min = "1900-01-01",
                    max = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")
                }
            )
            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Gender, new { @class = "form-label" })
            @Html.DropDownListFor(
                m => m.Gender,
                (SelectList)ViewBag.GenderList,
                "-- Select Gender --",
                new { @class = "form-select" }
            )
            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>

        <div class="mb-1">
            @Html.LabelFor(m => m.InsuranceID, new { @class = "form-label" })
            @Html.TextBoxFor(
                m => m.InsuranceID,
                new
                {
                    @class = "form-control",
                    placeholder = "Optional - leave blank if uninsured"
                }
            )
            @Html.ValidationMessageFor(m => m.InsuranceID, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="modal-footer patient-modal-footer">
        <button type="submit" class="btn btn-save-patient">Save Changes</button>
        <button type="button" class="btn btn-secondary btn-cancel-patient" data-bs-dismiss="modal">Cancel</button>
    </div>
}