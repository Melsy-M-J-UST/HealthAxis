@model HealthAxis.Shared.DTOs.PatientDto

@{
    ViewBag.Title = "Patient Details";
}

<div class="container mt-4">
    <h2>Patient Details</h2>
    <hr />

    <div class="card">
        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-3">Patient ID</dt>
                <dd class="col-sm-9">@Model.PatientId</dd>

                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Date of Birth</dt>
                <dd class="col-sm-9">@Model.DateOfBirth.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Gender</dt>
                <dd class="col-sm-9">@Model.GenderName</dd>

                <dt class="col-sm-3">Phone Number</dt>
                <dd class="col-sm-9">@Model.PhoneNumber</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Insurance ID</dt>
                <dd class="col-sm-9">@Model.InsuranceID</dd>

                @if (Model.CreatedDate.HasValue)
                {
                    <dt class="col-sm-3">Created Date</dt>
                    <dd class="col-sm-9">@Model.CreatedDate.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                }
            </dl>

            <div class="mt-3">
                @Html.ActionLink("Edit", "Edit", "Patient", new { id = Model.PatientId }, new { @class = "btn btn-warning" })
                @Html.ActionLink("Back to List", "ApiIndex", "Patient", null, new { @class = "btn btn-secondary ms-2" })
            </div>

        </div>
    </div>
</div>