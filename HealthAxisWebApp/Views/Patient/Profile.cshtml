@model HealthAxis.Shared.DTOs.PatientDto

<div class="container mt-4">
    <div class="page-header-card">
        <h2>Patient Profile</h2>
    </div>

    <div class="card">
        <div class="card-body">

            <p><strong>Name:</strong> @Model.FullName</p>
            <p><strong>DOB:</strong> @Model.DateOfBirth.ToString("yyyy-MM-dd")</p>
            <p><strong>Gender:</strong> @Model.GenderName</p>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Phone:</strong> @Model.PhoneNumber</p>
            <p><strong>Insurance:</strong> @Model.InsuranceID</p>

            <hr />

            <h5>Appointments</h5>
            <p><strong>Total:</strong> @Model.AppointmentCount</p>

            <div class="mt-3">
                @Html.ActionLink("Back", "Index", null,
                    new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
</div>