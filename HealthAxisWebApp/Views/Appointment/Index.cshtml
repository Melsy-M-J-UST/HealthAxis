@model IEnumerable<HealthAxisWebApp.Appointment>

@{
    ViewBag.Title = "Appointments";
}

<h2>Appointments</h2>

<p>
    @Html.ActionLink(
        "Book Appointment",
        "Create",
        null,
        new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <tr>
        <th>ID</th>
        <th>Patient</th>
        <th>Doctor</th>
        <th>Date</th>
        <th>Time Slot</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.AppointmentId</td>

            <td>@item.Patient.FullName</td>

            <td>@item.Doctor.FullName</td>

            <td>@item.ScheduledDate.ToShortDateString()</td>

            <td>@item.TimeSlot</td>

            <td>
                @(item.Status == 0 ? "Pending" :
                  item.Status == 1 ? "Confirmed" :
                  item.Status == 2 ? "Cancelled" :
                  item.Status == 3 ? "Completed" :
                  "Unknown")
            </td>

            <td>

                @Html.ActionLink(
                    "Details",
                    "Details",
                    new { id = item.AppointmentId },
                    new { @class = "btn btn-info btn-sm" })

                @Html.ActionLink(
                    "Edit",
                    "Edit",
                    new { id = item.AppointmentId },
                    new { @class = "btn btn-warning btn-sm" })

                @if (item.Status == 0 || item.Status == 1)
                {
                    @Html.ActionLink(
                        "Cancel",
                        "Cancel",
                        new { id = item.AppointmentId },
                        new { @class = "btn btn-danger btn-sm" })
                }
                @if (item.Status == 0)
                {
                    @Html.ActionLink(
                        "Confirm",
                        "Confirm",
                        new { id = item.AppointmentId },
                        new { @class = "btn btn-success btn-sm" })
                }

                @if (item.Status == 1)
                {
                    @Html.ActionLink(
                        "Complete",
                        "Complete",
                        new { id = item.AppointmentId },
                        new { @class = "btn btn-primary btn-sm" })
                }

            </td>
        </tr>
    }
</table>