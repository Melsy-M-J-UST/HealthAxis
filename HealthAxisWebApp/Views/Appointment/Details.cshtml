@model HealthAxis.Shared.DTOs.AppointmentDto

@{
    ViewBag.Title = "Appointment Details";
}

<div class="container mt-4">

    <h2>Appointment Details</h2>

    <hr />

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Appointment ID</dt>
                <dd class="col-sm-9">@Model.AppointmentId</dd>

                <dt class="col-sm-3">Patient</dt>
                <dd class="col-sm-9">@Model.PatientName</dd>

                <dt class="col-sm-3">Doctor</dt>
                <dd class="col-sm-9">@Model.DoctorName</dd>

                <dt class="col-sm-3">Scheduled Date</dt>
                <dd class="col-sm-9">
                    @Model.ScheduledDate.ToString("yyyy-MM-dd")
                </dd>

                <dt class="col-sm-3">Time Slot</dt>
                <dd class="col-sm-9">@Model.TimeSlotName</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">

                    @if (Model.Status == 0)
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                    else if (Model.Status == 1)
                    {
                        <span class="badge bg-primary">Confirmed</span>
                    }
                    else if (Model.Status == 2)
                    {
                        <span class="badge bg-danger">Cancelled</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Completed</span>
                    }

                </dd>

                @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                {
                    <dt class="col-sm-3">
                        Cancellation Reason
                    </dt>

                    <dd class="col-sm-9">
                        @Model.CancellationReason
                    </dd>
                }

            </dl>

            <div class="mt-4 d-flex flex-wrap gap-2">

                @Html.ActionLink(
                    "Edit",
                    "Edit",
                    new { id = Model.AppointmentId },
                    new { @class = "btn btn-warning" })

                @if (Model.Status == 0)
                {
                    using (Html.BeginForm(
                        "Confirm",
                        "Appointment",
                        new { id = Model.AppointmentId },
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-success">
                            Confirm
                        </button>
                    }
                }

                @if (Model.Status == 1)
                {
                    using (Html.BeginForm(
                        "Complete",
                        "Appointment",
                        new { id = Model.AppointmentId },
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-primary">
                            Complete Appointment
                        </button>
                    }
                }

                @if (Model.Status == 0 ||
                     Model.Status == 1)
                {
                    @Html.ActionLink(
                        "Cancel Appointment",
                        "Cancel",
                        new { id = Model.AppointmentId },
                        new { @class = "btn btn-danger" })
                }

                @if (Model.Status == 3)
                {
                    @Html.ActionLink(
                        "Add Health Record",
                        "Create",
                        "HealthRecord",
                        new
                        {
                            appointmentId = Model.AppointmentId,
                            patientId = Model.PatientId,
                            doctorId = Model.DoctorId
                        },
                        new
                        {
                            @class = "btn btn-success"
                        })
                }

                @Html.ActionLink(
                    "Back",
                    "Dashboard",
                    "Appointment",
                    null,
                    new
                    {
                        @class = "btn btn-secondary"
                    })

            </div>

        </div>
    </div>

</div>