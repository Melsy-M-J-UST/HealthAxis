@{
    ViewBag.Title = "Appointment Management";
}

<style>
    .dashboard-card {
        border-radius: 12px;
        height: 200px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        transition: all 0.2s ease-in-out;
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 8px 20px rgba(0,0,0,0.15);
        }

    .card-content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        width: 100%;
    }

    .card-title {
        font-size: 20px;
        font-weight: 600;
    }

    .card-desc {
        font-size: 14px;
        color: #666;
        margin: 10px 0 15px 0;
    }

    .btn-card {
        background: linear-gradient(135deg, #6ee7b7, #34d399);
        border: none;
        color: white;
        padding: 10px;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
    }

        .btn-card:hover {
            background: linear-gradient(135deg, #34d399, #10b981);
            color: white;
        }
</style>

<div class="container mt-5">

    <h2 class="text-center mb-5">Appointment Dashboard (●'◡'●)</h2>

    <!-- FIRST ROW -->
    <div class="row justify-content-center g-4">

        <div class="col-md-5">
            <div class="card dashboard-card p-3 shadow-sm">
                <div class="card-content">
                    <div>
                        <div class="card-title">View Appointments</div>
                        <div class="card-desc">Browse and filter all appointments.</div>
                    </div>

                    @Html.ActionLink(
                        "Open",
                        "List",
                        "Appointment",
                        null,
                        new { @class = "btn btn-card w-100" }
                    )
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card dashboard-card p-3 shadow-sm">
                <div class="card-content">
                    <div>
                        <div class="card-title">Book Appointment</div>
                        <div class="card-desc">Schedule a new appointment.</div>
                    </div>

                    @Html.ActionLink(
                        "Create",
                        "Create",
                        "Appointment",
                        null,
                        new { @class = "btn btn-card w-100" }
                    )
                </div>
            </div>
        </div>

    </div>

    <hr class="my-5" />

    <!-- SECOND ROW -->
    <div class="row justify-content-center g-4">

        <div class="col-md-5">
            <div class="card dashboard-card p-3 shadow-sm">
                <div class="card-content">
                    <div>
                        <div class="card-title">My Appointments</div>
                        <div class="card-desc">View patient appointment history.</div>
                    </div>

@Html.ActionLink(
    "View",
    "MyAppointments",
    "Appointment",
    null,
    new { @class = "btn btn-card w-100" }
)
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card dashboard-card p-3 shadow-sm">
                <div class="card-content">
                    <div>
                        <div class="card-title">View Schedule</div>
                        <div class="card-desc">Check doctor schedules.</div>
                    </div>

                    @Html.ActionLink(
                        "Open",
                        "SelectDoctor",
                        "Appointment",
                        null,
                        new { @class = "btn btn-card w-100" }
                    )
                </div>
            </div>
        </div>

    </div>

</div>