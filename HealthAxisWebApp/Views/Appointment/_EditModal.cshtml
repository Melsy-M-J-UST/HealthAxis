@model HealthAxis.Shared.DTOs.AppointmentDto

<style>
    .appointment-edit-header {
        background: linear-gradient(135deg, #315e78, #3c6d87);
        color: #fff;
        padding: 16px 20px;
        border-bottom: none;
    }

        .appointment-edit-header .modal-title {
            font-size: 1.3rem;
            font-weight: 700;
            margin: 0;
        }

        .appointment-edit-header .btn-close {
            filter: invert(1);
            opacity: 0.9;
        }

    .appointment-edit-body {
        padding: 24px;
        background: rgba(255,255,255,0.96);
    }

        .appointment-edit-body .form-label {
            font-weight: 600;
            color: #1f2a44;
            margin-bottom: 6px;
        }

        .appointment-edit-body .form-control,
        .appointment-edit-body .form-select {
            border-radius: 10px;
            min-height: 44px;
            box-shadow: none;
        }

            .appointment-edit-body .form-control:focus,
            .appointment-edit-body .form-select:focus {
                border-color: #61c4b2;
                box-shadow: 0 0 0 0.18rem rgba(97, 196, 178, 0.18);
            }

    .appointment-edit-footer {
        border-top: 1px solid #e7edf1;
        padding: 14px 20px;
        background: #fafcfd;
    }
</style>

@using (Html.BeginForm("Edit", "Appointment", new { id = Model.AppointmentId }, FormMethod.Post, new { data_ajax_modal = "true" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.AppointmentId)

    <div class="modal-header appointment-edit-header">
        <h5 class="modal-title">Edit Appointment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body appointment-edit-body">
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="mb-3">
            @Html.LabelFor(m => m.PatientId, new { @class = "form-label" })
            @Html.DropDownListFor(
                m => m.PatientId,
                (SelectList)ViewBag.PatientList,
                "-- Select Patient --",
                new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.PatientId, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.DoctorId, new { @class = "form-label" })
            @Html.DropDownListFor(
                m => m.DoctorId,
                (SelectList)ViewBag.DoctorList,
                "-- Select Doctor --",
                new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.ScheduledDate, new { @class = "form-label" })
            @Html.TextBoxFor(
                m => m.ScheduledDate,
                "{0:yyyy-MM-dd}",
                new
                {
                    @class = "form-control",
                    type = "date",
                    min = DateTime.Today.ToString("yyyy-MM-dd"),
                    max = DateTime.Today.AddMonths(3).ToString("yyyy-MM-dd")
                })
            @Html.ValidationMessageFor(m => m.ScheduledDate, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.TimeSlot, new { @class = "form-label" })
            @Html.DropDownListFor(
                m => m.TimeSlot,
                (SelectList)ViewBag.TimeSlotList,
                "-- Select Time Slot --",
                new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.TimeSlot, "", new { @class = "text-danger" })
        </div>

        @Html.HiddenFor(m => m.Status)
    </div>

    <div class="modal-footer appointment-edit-footer">
        <button type="submit" class="btn btn-success">Save Changes</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
}