@model HealthAxis.Shared.DTOs.AppointmentDto

@{
    ViewBag.Title = "Edit Appointment";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="page-header-card">
        <h2>Edit Appointment</h2>
        <p>Update appointment details.</p>
    </div>

    @using (Html.BeginForm("Edit", "Appointment", new { id = Model.AppointmentId }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.AppointmentId)

        <div class="card">
            <div class="card-body">

                <!-- VALIDATION SUMMARY -->
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <!-- PATIENT -->
                <div class="mb-3">
                    @Html.LabelFor(m => m.PatientId, new { @class = "form-label" })
                    @Html.DropDownListFor(
                        m => m.PatientId,
                        (SelectList)ViewBag.PatientList,
                        "-- Select Patient --",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.PatientId, "", new { @class = "text-danger" })
                </div>

                <!-- DOCTOR -->
                <div class="mb-3">
                    @Html.LabelFor(m => m.DoctorId, new { @class = "form-label" })
                    @Html.DropDownListFor(
                        m => m.DoctorId,
                        (SelectList)ViewBag.DoctorList,
                        "-- Select Doctor --",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger" })
                </div>

                <!-- DATE -->
                <div class="mb-3">
                    @Html.LabelFor(m => m.ScheduledDate, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.ScheduledDate,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control",
                            type = "date",
                            min = DateTime.Today.ToString("yyyy-MM-dd") //  no past dates
                        })
                    @Html.ValidationMessageFor(m => m.ScheduledDate, "", new { @class = "text-danger" })
                </div>

                <!-- TIME SLOT -->
                <div class="mb-3">
                    @Html.LabelFor(m => m.TimeSlot, new { @class = "form-label" })
                    @Html.DropDownListFor(
                        m => m.TimeSlot,
                        (SelectList)ViewBag.TimeSlotList,
                        "-- Select Time Slot --",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.TimeSlot, "", new { @class = "text-danger" })
                </div>

                <!-- STATUS (READ-ONLY) -->
                <div class="mb-3">
                    <label class="form-label">Status</label>

                    <p class="form-control-plaintext">
                        @if (Model.Status == 0)
                        {
                            <span class="badge bg-warning">Pending</span>
                        }
                        else if (Model.Status == 1)
                        {
                            <span class="badge bg-primary">Confirmed</span>
                        }
                        else if (Model.Status == 2)
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Completed</span>
                        }
                    </p>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="mt-4 d-flex gap-2">

                    <button type="submit" class="btn btn-success">
                        Save Changes
                    </button>

                    @Html.ActionLink(
                        "Back to List",
                        "Index",
                        null,
                        new { @class = "btn btn-secondary" })

                </div>

            </div>
        </div>
    }

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}