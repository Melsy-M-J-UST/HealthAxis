@model HealthAxis.Shared.DTOs.AppointmentDto

@{
    ViewBag.Title = "Delete Appointment";
}

<div class="container mt-4">
    <h2>Delete Appointment</h2>
    <hr />

    <div class="alert alert-warning">
        Are you sure you want to delete this appointment?
    </div>

    <div class="card">
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <dl class="row">
                <dt class="col-sm-3">Appointment ID</dt>
                <dd class="col-sm-9">@Model.AppointmentId</dd>

                <dt class="col-sm-3">Patient</dt>
                <dd class="col-sm-9">@Model.PatientName</dd>

                <dt class="col-sm-3">Doctor</dt>
                <dd class="col-sm-9">@Model.DoctorName</dd>

                <dt class="col-sm-3">Scheduled Date</dt>
                <dd class="col-sm-9">@Model.ScheduledDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Time Slot</dt>
                <dd class="col-sm-9">@Model.TimeSlotName</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.StatusName</dd>

                <dt class="col-sm-3">Cancellation Reason</dt>
                <dd class="col-sm-9">@Model.CancellationReason</dd>
            </dl>

            @using (Html.BeginForm("Delete", "Appointment", new { id = Model.AppointmentId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">Delete</button>
                @Html.ActionLink("Cancel", "ApiIndex", "Appointment", null, new { @class = "btn btn-secondary ms-2" })
            }

        </div>
    </div>
</div>