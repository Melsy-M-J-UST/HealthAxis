@model HealthAxis.Shared.DTOs.DoctorDto

@{
    ViewBag.Title = "Edit Doctor";
}

<div class="container mt-4">
    <h2>Edit Doctor</h2>
    <hr />

    @using (Html.BeginForm("Edit", "Doctor", new { id = Model.DoctorId }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.DoctorId)

        <div class="card">
            <div class="card-body">

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    @Html.LabelFor(model => model.FullName, "Doctor Name", new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.FullName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })

                    <small class="text-muted">
                        Note: current validation may allow letters only. Avoid spaces/dots if validation fails.
                    </small>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Specialisation, "Specialisation", new { @class = "form-label" })
                    @Html.DropDownListFor(
                        model => model.Specialisation,
                        (SelectList)ViewBag.SpecialisationList,
                        "-- Select Specialisation --",
                        new { @class = "form-control" }
                    )
                    @Html.ValidationMessageFor(model => model.Specialisation, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.YearsOfExperience, "Years of Experience", new { @class = "form-label" })
                    @Html.TextBoxFor(
                        model => model.YearsOfExperience,
                        new { @class = "form-control", type = "number", min = "0", max = "70" }
                    )
                    @Html.ValidationMessageFor(model => model.YearsOfExperience, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.ConsultationFee, "Consultation Fee", new { @class = "form-label" })
                    @Html.TextBoxFor(
                        model => model.ConsultationFee,
                        new { @class = "form-control", type = "number", step = "0.01", min = "0" }
                    )
                    @Html.ValidationMessageFor(model => model.ConsultationFee, "", new { @class = "text-danger" })
                </div>

                <div class="form-check mb-3">
                    @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input" })
                    @Html.LabelFor(model => model.IsActive, "Active", new { @class = "form-check-label" })
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Save Changes</button>
                    @Html.ActionLink("Back to List", "ApiIndex", "Doctor", null, new { @class = "btn btn-secondary ms-2" })
                </div>

            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}