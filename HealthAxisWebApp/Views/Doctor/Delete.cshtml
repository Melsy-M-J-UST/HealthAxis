@model HealthAxis.Shared.DTOs.DoctorDto

@{
    ViewBag.Title = "Delete Doctor";
}

<div class="container mt-4">
    <h2>Delete Doctor</h2>
    <hr />

    <div class="alert alert-warning">
        Are you sure you want to delete this doctor?
    </div>

    <div class="card">
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <dl class="row">
                <dt class="col-sm-3">Doctor ID</dt>
                <dd class="col-sm-9">@Model.DoctorId</dd>

                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Specialisation</dt>
                <dd class="col-sm-9">@Model.SpecialisationName</dd>

                <dt class="col-sm-3">Years of Experience</dt>
                <dd class="col-sm-9">@Model.YearsOfExperience years</dd>

                <dt class="col-sm-3">Consultation Fee</dt>
                <dd class="col-sm-9">@Model.ConsultationFee.ToString("0.00")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>
            </dl>

            @using (Html.BeginForm("Delete", "Doctor", new { id = Model.DoctorId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">Delete</button>
                @Html.ActionLink("Cancel", "ApiIndex", "Doctor", null, new { @class = "btn btn-secondary ms-2" })
            }

        </div>
    </div>
</div>