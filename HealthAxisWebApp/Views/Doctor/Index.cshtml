@using System.Linq
@model IEnumerable<HealthAxis.Shared.DTOs.DoctorDto>

@{
    ViewBag.Title = "Doctors";

    var currentSort = ViewBag.SortBy as string ?? "name";
    var currentSpec = ViewBag.Specialisation as string ?? "all";
}

<div class="container mt-4">

    <div class="page-header-card d-flex justify-content-between align-items-center">
        <div>
            <h2>Doctors</h2>
            <p>Manage doctor profiles and availability.</p>
        </div>

        <a href="@Url.Action("Create", "Doctor")" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Doctor
        </a>
    </div>

    <form method="get" class="row g-3 mb-3">

        <div class="col-md-3">
            <label class="form-label">Sort By</label>
            <select name="sortBy" class="form-select">
                <option value="name" @(currentSort == "name" ? "selected" : null)>Name (A-Z)</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Specialisation</label>
            <select name="specialisation" class="form-select">
                <option value="all">All</option>
                @if (ViewBag.SpecialisationList != null)
                {
                    foreach (var item in (SelectList)ViewBag.SpecialisationList)
                    {
                        <option value="@item.Value" @(item.Value.ToString() == currentSpec ? "selected" : null)>
                            @item.Text
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2 align-self-end">
            <button type="submit" class="btn btn-success w-100">
                Apply
            </button>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No doctors found.
        </div>
    }
    else
    {
        <div class="data-table-wrap">
            <table class="table data-table table-bordered align-middle">
                <thead>
                    <tr>
                        <th style="width: 6%;">ID</th>
                        <th style="width: 20%;">Name</th>
                        <th style="width: 16%;">Specialisation</th>
                        <th style="width: 11%;">Experience</th>
                        <th style="width: 12%;">Fee</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 25%;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DoctorId</td>
                            <td class="truncate-cell" title="@item.FullName">@item.FullName</td>
                            <td class="truncate-cell" title="@item.SpecialisationName">@item.SpecialisationName</td>
                            <td>@item.YearsOfExperience yrs</td>
                            <td>₹@item.ConsultationFee</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-soft-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge-soft-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="action-bar">
                                    <button type="button"
                                            class="btn btn-info btn-sm open-doctor-modal"
                                            data-url="@Url.Action("DoctorProfile", "Doctor", new { id = item.DoctorId })">
                                        Profile
                                    </button>

                                    <button type="button"
                                            class="btn btn-warning btn-sm open-doctor-modal"
                                            data-url="@Url.Action("Edit", "Doctor", new { id = item.DoctorId })">
                                        Edit
                                    </button>

                                    <button type="button"
                                            class="btn btn-danger btn-sm open-doctor-modal"
                                            data-url="@Url.Action("Toggle", "Doctor", new { id = item.DoctorId })">
                                        @(item.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="modal fade" id="doctorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div id="doctorModalContent"></div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(function () {
            var doctorModalElement = document.getElementById('doctorModal');
            var doctorModal = new bootstrap.Modal(doctorModalElement);

            $(document).on('click', '.open-doctor-modal', function (e) {
                e.preventDefault();

                var url = $(this).data('url');

                $.get(url, function (html) {
                    $('#doctorModalContent').html(html);
                    $.validator.unobtrusive.parse('#doctorModalContent');
                    doctorModal.show();
                });
            });

            $(document).on('submit', 'form[data-ajax-modal="true"]', function (e) {
                e.preventDefault();

                var form = $(this);

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    success: function (response) {
                        if (response && response.success) {
                            doctorModal.hide();
                            window.location.reload();
                        } else {
                            $('#doctorModalContent').html(response);
                            $.validator.unobtrusive.parse('#doctorModalContent');
                        }
                    }
                });
            });
        });
    </script>
}