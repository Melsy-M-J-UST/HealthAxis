@model HealthAxis.Shared.DTOs.DoctorDto

@{
    ViewBag.Title = "Doctor Details";
}

<div class="container mt-4">
    <h2>Doctor Details</h2>
    <hr />

    <div class="card">
        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-3">Doctor ID</dt>
                <dd class="col-sm-9">@Model.DoctorId</dd>

                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Specialisation</dt>
                <dd class="col-sm-9">@Model.SpecialisationName</dd>

                <dt class="col-sm-3">Years of Experience</dt>
                <dd class="col-sm-9">@Model.YearsOfExperience years</dd>

                <dt class="col-sm-3">Consultation Fee</dt>
                <dd class="col-sm-9">@Model.ConsultationFee.ToString("0.00")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>
            </dl>

            <div class="mt-3">
                @Html.ActionLink("Edit", "Edit", "Doctor", new { id = Model.DoctorId }, new { @class = "btn btn-warning" })
                @Html.ActionLink("Back to List", "ApiIndex", "Doctor", null, new { @class = "btn btn-secondary ms-2" })
            </div>

        </div>
    </div>
</div>