@model HealthAxis.Shared.DTOs.DoctorDto

@{
    ViewBag.Title = "Create Doctor";
}

<div class="container mt-4">

    <div class="page-header-card">
        <h2>Create Doctor</h2>
        <p>Add a new doctor with validated details.</p>
    </div>

    @using (Html.BeginForm("Create", "Doctor", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="card">
            <div class="card-body">

                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                    @Html.TextBoxFor(
                        m => m.FullName,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Enter full name"
                        })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Specialisation, new { @class = "form-label" })
                    @Html.DropDownListFor(
                        m => m.Specialisation,
                        (SelectList)ViewBag.SpecialisationList,
                        "-- Select Specialisation --",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.YearsOfExperience, new { @class = "form-label" })
                    @Html.TextBoxFor(
                        m => m.YearsOfExperience,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Enter years of experience"
                        })
                    @Html.ValidationMessageFor(m => m.YearsOfExperience, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.ConsultationFee, new { @class = "form-label" })
                    @Html.TextBoxFor(
                        m => m.ConsultationFee,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Enter consultation fee"
                        })
                    @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Create Doctor
                    </button>

                    @Html.ActionLink(
                        "Back to List",
                        "Index",
                        "Doctor",
                        null,
                        new { @class = "btn btn-secondary" })
                </div>

            </div>
        </div>
    }

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
