@model HealthAxis.Shared.DTOs.DoctorDto

@{
    ViewBag.Title = "Add Doctor";
}

<div class="container mt-4">

    <div class="page-header-card">
        <h2>Add Doctor</h2>
        <p>Register a new doctor.</p>
    </div>

    @using (Html.BeginForm("Create", "Doctor", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="card">
            <div class="card-body">

                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <!-- NAME -->
                <div class="mb-3">
                    @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                </div>

                <!-- SPECIALISATION -->
                <div class="mb-3">
                    @Html.LabelFor(m => m.Specialisation, new { @class = "form-label" })
                    @Html.DropDownListFor(
                        m => m.Specialisation,
                        (SelectList)ViewBag.SpecialisationList,
                        "-- Select Specialisation --",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger" })
                </div>

                <!-- EXPERIENCE -->
                <div class="mb-3">
                    @Html.LabelFor(m => m.YearsOfExperience, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.YearsOfExperience, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.YearsOfExperience, "", new { @class = "text-danger" })
                </div>

                <!-- FEE -->
                <div class="mb-3">
                    @Html.LabelFor(m => m.ConsultationFee, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.ConsultationFee, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
                </div>

                <!-- ACTIONS -->
                <div class="mt-4">
                    <button type="submit" class="btn btn-success">
                        Create
                    </button>

                    @Html.ActionLink("Back", "Index", null,
                        new { @class = "btn btn-secondary ms-2" })
                </div>

            </div>
        </div>
    }

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}