@{
    ViewBag.Title = "About HealthAxis";
}

<div class="container mt-4">
    <div class="jumbotron">
        <h2>About HealthAxis</h2>
        <p class="lead">
            HealthAxis is a hospital appointment and health record management system
            designed to simplify interactions between patients and doctors.
        </p>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h4>For Patients</h4>
            <p>
                Patients can register, log in, book appointments with available doctors,
                view their appointments, and access their health history in one place.
            </p>
        </div>

        <div class="col-md-6">
            <h4>For Doctors</h4>
            <p>
                Doctors can manage schedules, view appointments, update appointment
                statuses, and create health records after consultations.
            </p>
        </div>
    </div>

    <hr />

    <h4>Key Features</h4>

    <ul>
        <li>Patient registration and login</li>
        <li>Doctor registration and management</li>
        <li>Appointment booking with time slot validation</li>
        <li>Doctor schedule management</li>
        <li>Patient health history tracking</li>
        <li>Role-based access for patients and doctors</li>
        <li>Secure password hashing with salt</li>
    </ul>

    

  
</div>