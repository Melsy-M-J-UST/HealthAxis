@{
    ViewBag.Title = "Doctor Profile";
}

<div class="ha-page" style="display:flex;align-items:center">
    <div class="container">

        <div class="ha-card" style="max-width:500px;margin:0 auto;padding:38px;text-align:center">
            <h2 class="ha-title">Doctor Profile</h2>
            <p class="ha-muted">Enter Doctor ID to view doctor profile and upcoming appointment count.</p>

            @using (Html.BeginForm("Details", "Doctors", FormMethod.Get))
            {
                <input type="number"
                       name="id"
                       class="form-control"
                       placeholder="Enter Doctor ID"
                       required
                       style="max-width:420px;margin:25px auto;text-align:center" />

                <div class="ha-actions">
                    <button type="submit" class="btn btn-success pill-btn">
                        View Profile
                    </button>

                    @Html.ActionLink(
                        "Back",
                        "Index",
                        "Doctors",
                        null,
                        new { @class = "btn btn-dark-back" })
                </div>
            }
        </div>

    </div>
</div>