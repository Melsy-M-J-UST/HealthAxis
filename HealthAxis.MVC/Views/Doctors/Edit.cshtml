@model HealthAxis.Shared.DTOs.DoctorDto

@{
    ViewBag.Title = "Doctor";
}

<div class="ha-page">
    <div class="container">

        <div class="ha-card" style="max-width: 760px; margin: 0 auto; padding: 34px;">

            <div style="text-align: center; border-bottom: 1px solid #334155; padding-bottom: 22px; margin-bottom: 30px;">
                <h2 class="ha-title">
                    Doctor
                </h2>

                <p class="ha-muted">
                    Add or update doctor profile, specialisation, experience, and consultation fee.
                </p>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.DoctorId)

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="ha-section-title">
                    Doctor Information
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.FullName)

                    @Html.TextBoxFor(m => m.FullName, new
                    {
                        @class = "form-control",
                        placeholder = "Enter doctor full name"
                    })

                    @Html.ValidationMessageFor(
                        m => m.FullName,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Specialisation)

                    @Html.DropDownListFor(
                        m => m.Specialisation,
                        ViewBag.SpecialisationList as SelectList,
                        "Select Specialisation",
                        new { @class = "form-control" })

                    @Html.ValidationMessageFor(
                        m => m.Specialisation,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="ha-section-title">
                    Professional Details
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.YearsOfExperience)

                            @Html.TextBoxFor(m => m.YearsOfExperience, new
                            {
                                @class = "form-control",
                                type = "number",
                                min = "0",
                                placeholder = "Years of experience"
                            })

                            @Html.ValidationMessageFor(
                                m => m.YearsOfExperience,
                                "",
                                new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.ConsultationFee)

                            @Html.TextBoxFor(m => m.ConsultationFee, new
                            {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "1",
                                placeholder = "Consultation fee"
                            })

                            @Html.ValidationMessageFor(
                                m => m.ConsultationFee,
                                "",
                                new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="ha-actions">
                    <button type="submit" class="btn btn-primary pill-btn">
                        Update
                    </button>

                    @Html.ActionLink(
                        "Back",
                        "Index",
                        "Doctors",
                        null,
                        new { @class = "btn btn-dark-back" })
                </div>
            }

        </div>

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}