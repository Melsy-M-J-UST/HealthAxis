@model IEnumerable<HealthAxis.Shared.DTOs.DoctorDto>

@{
    ViewBag.Title = "Search Doctors";
}

<div class="ha-page">
    <div class="container">

        <div class="ha-card" style="padding:30px;">

            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; border-bottom:1px solid #334155; padding-bottom:18px;">
                <div>
                    <h2 class="ha-title" style="margin:0;">
                        Search Doctors
                    </h2>

                    <p class="ha-muted" style="margin:6px 0 0 0;">
                        Search active doctors by specialisation and proceed to appointment booking.
                    </p>
                </div>

                @Html.ActionLink(
                    "Back",
                    "Index",
                    "Patients",
                    null,
                    new { @class = "btn btn-dark-back" })
            </div>

            @using (Html.BeginForm("SearchDoctors", "Patients", FormMethod.Get))
            {
                <div style="margin-bottom:24px;">
                    @Html.DropDownList(
                        "specialisation",
                        ViewBag.SpecialisationList as SelectList,
                        "All Specialisations",
                        new
                        {
                            @class = "form-control",
                            style = "max-width:350px;display:inline-block;margin-right:10px;"
                        })

                    <button type="submit" class="btn btn-primary pill-btn">
                        Search
                    </button>
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    No doctors found.
                </div>
            }
            else
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Doctor ID</th>
                            <th>Name</th>
                            <th>Specialisation</th>
                            <th>Experience</th>
                            <th>Fee</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var doctor in Model)
                        {
                            <tr>
                                <td>@doctor.DoctorId</td>
                                <td>@doctor.FullName</td>
                                <td>@doctor.Specialisation</td>
                                <td>@doctor.YearsOfExperience years</td>
                                <td>@doctor.ConsultationFee</td>
                                <td>
                                    @Html.ActionLink(
                                        "Book",
                                        "Book",
                                        "Appointments",
                                        null,
                                        new { @class = "btn btn-success btn-sm" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>

    </div>
</div>