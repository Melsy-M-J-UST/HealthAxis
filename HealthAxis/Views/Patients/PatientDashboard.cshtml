@model HealthAxis.Shared.DTOs.PatientDto

@{
    ViewBag.Title = "Patient Dashboard";
}

<h2>Patient Dashboard</h2>

<div class="alert alert-info">
    Welcome, <strong>@Model.FullName</strong>
</div>

<table class="table table-bordered">
    <tr>
        <th>Full Name</th>
        <td>@Model.FullName</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>
    <tr>
        <th>Phone</th>
        <td>@Model.PhoneNumber</td>
    </tr>
    <tr>
        <th>Insurance</th>
        <td>
            @if (!string.IsNullOrWhiteSpace(Model.InsuranceID))
            {
                <span class="label label-success">Insured</span>
            }
            else
            {
                <span class="label label-warning">No Insurance</span>
            }
        </td>
    </tr>
    <tr>
        <th>Status</th>
        <td>
            @if (Model.IsActive)
            {
                <span class="label label-success">Active</span>
            }
            else
            {
                <span class="label label-danger">Inactive</span>
            }
        </td>
    </tr>
    <tr>
        <th>Total Appointments</th>
        <td>@Model.AppointmentCount</td>
    </tr>
</table>

<hr />

<h4>Actions</h4>

<div class="row">
    <div class="col-md-4">
        @Html.ActionLink(
            "Book Appointment",
            "Book",
            "Appointments",
            null,
            new { @class = "btn btn-primary btn-block" })
    </div>

    <div class="col-md-4">
        @Html.ActionLink(
            "View My Appointments",
            "MyAppointments",
            "Appointments",
            null,
            new { @class = "btn btn-info btn-block" })
    </div>

    <div class="col-md-4">
        @Html.ActionLink(
            "Search Doctors",
            "SearchDoctors",
            "Patients",
            null,
            new { @class = "btn btn-success btn-block" })
    </div>
</div>

<br />

<div class="row">
    <div class="col-md-4">
        @Html.ActionLink(
            "View Health Records",
            "PatientHistory",
            "HealthRecords",
            null,
            new { @class = "btn btn-warning btn-block" })
    </div>

    <div class="col-md-4">
        @Html.ActionLink(
            "View Profile",
            "MyProfile",
            "Patients",
            null,
            new { @class = "btn btn-secondary btn-block" })
    </div>

    <div class="col-md-4">
        @Html.ActionLink(
            "Update Profile",
            "EditMyProfile",
            "Patients",
            null,
            new { @class = "btn btn-dark btn-block" })
    </div>
</div>