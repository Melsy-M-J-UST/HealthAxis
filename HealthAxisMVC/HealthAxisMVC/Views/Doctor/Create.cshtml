@model HealthAxisMVC.Models.Doctor

@{
    ViewBag.Title = "Create";
}

<h2>Add Doctor</h2>

@using (Html.BeginForm())
{ 
<div class="mb-2">
    @Html.LabelFor(m => m.DoctorId, new { @class = "fw-bold" })
    @Html.TextBoxFor(m => m.DoctorId, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger" })
</div>    
 
<div class="mb-2">
    @Html.LabelFor(m => m.FullName)
    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
</div>

<div class="mb-2">
    @Html.LabelFor(m => m.Specialisation)
    @Html.DropDownListFor(m => m.Specialisation,
        new SelectList(Enum.GetValues(typeof(HealthAxisMVC.Models.Doctor.SpecialisationOption))),
        "Select Specialisation",
        new { @class = "form-control" })
</div>

<div class="mb-2">
    @Html.LabelFor(m => m.YearsOfExperience)
    @Html.TextBoxFor(m => m.YearsOfExperience, new { @class = "form-control" })
</div>

<div class="mb-2">
    @Html.LabelFor(m => m.ConsultationFee)
    @Html.TextBoxFor(m => m.ConsultationFee, new { @class = "form-control" })
</div>

<div class="mb-2">
    @Html.LabelFor(m => m.IsActive)
    @Html.CheckBoxFor(m => m.IsActive)
</div>

<button class="btn btn-primary">Add Doctor</button>
@Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}



