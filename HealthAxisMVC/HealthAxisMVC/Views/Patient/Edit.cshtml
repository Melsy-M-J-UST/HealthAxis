@model HealthAxisMVC.Models.Patient
@{
    ViewBag.Title = "Edit";
}
<h2>Edit</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.PatientId)

    <div class="mb-2">
        @Html.LabelFor(m => m.FullName)
        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
    </div>

    <div class="mb-2">
        @Html.LabelFor(m => m.DateOfBirth)
        @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
    </div>

    <div class="mb-2">
        @Html.LabelFor(m => m.Gender)
        @Html.DropDownListFor(m => m.Gender,
            new SelectList(Enum.GetValues(typeof(HealthAxisMVC.Models.Patient.GenderOptions))),
            new { @class = "form-control" })
    </div>

    <div class="mb-2">
        @Html.LabelFor(m => m.PhoneNumber)
        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
    </div>

    <div class="mb-2">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { type = "email", @class = "form-control" })
    </div>

    <div class="mb-2">
        @Html.LabelFor(m => m.InsuranceId)
        @Html.TextBoxFor(m => m.InsuranceId, new { @class = "form-control" })
    </div>

    <button class="btn btn-primary">Update</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}

