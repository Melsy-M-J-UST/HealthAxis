@model List<HealthAxisMVC.Models.Patient>
@{
    ViewBag.Title = "Index";
}

<h2 class="text-primary">Patient Details</h2>
@Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-primary" })

@using (Html.BeginForm("Details", "Patient", FormMethod.Get))
{
    <div class="mb-3 d-flex">
        <input type="number" name="id" class="form-control me-2 w-25" placeholder="Enter Patient ID" required />
        <button type="submit" class="btn btn-primary">Get Patient</button>
    </div>
}


<table class="table table-striped">
    <thead>
        <tr>
            <th>Patient ID</th>
            <th>Full Name</th>
            <th>Gender</th>
            <th>Date of birth</th>
            <th>Phone number</th>
            <th>Email</th>
            <th>Insurance ID</th>
            <th>Created Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.PatientId</td>
                <td>@p.FullName</td>
                <td>@p.Gender</td>
                <td>@p.DateOfBirth</td>
                <td>@p.PhoneNumber</td>
                <td>@p.Email</td>
                <td>@p.InsuranceId</td>
                <td>@p.CreatedDate</td>

                <td>
                    @Html.ActionLink("Edit", "Edit",
                        new { id = p.PatientId },
                        new { @class = "btn btn-warning btn-sm" })
                </td>

            </tr>
        }
        </tbody>
</table>

